private theorem checkedRows (v : Fin 79) : rowChecked v := by
  apply all_rows_of_blocks (v := v)
  rintro ⟨b,hb⟩
  change b<5 at hb
  interval_cases b <;> first | exact block0 | exact block1 | exact block2 | exact block3 | exact block4

