private def certified (s : Fin (vertexCount 4)) : List ℕ :=
  [row0,row1,row2,row3,row4,row5,row6,row7,row8,row9,row10,row11,row12,row13,row14,row15,row16,row17,row18,row19,row20,row21,row22,row23,row24][s.val]?.getD []

private theorem table (s : Fin (vertexCount 4)) : atStart 4 s.val=certified s := by
  rcases s with ⟨i,hi⟩
  change i<25 at hi
  interval_cases i
  · exact start0
  · exact start1
  · exact start2
  · exact start3
  · exact start4
  · exact start5
  · exact start6
  · exact start7
  · exact start8
  · exact start9
  · exact start10
  · exact start11
  · exact start12
  · exact start13
  · exact start14
  · exact start15
  · exact start16
  · exact start17
  · exact start18
  · exact start19
  · exact start20
  · exact start21
  · exact start22
  · exact start23
  · exact start24

private theorem supports_eq : allSupports 4=supports := by
  unfold allSupports
  rw [show (fun s : Fin (vertexCount 4) => atStart 4 s.val)=certified from funext table]
  decide +kernel

theorem pairs_eq : windowPairs 4=[(255,255), (255,510), (65025,130049), (130049,130050), (64515,129027), (129027,129030), (63495,126983), (126983,126990), (61455,122895), (122895,122910), (57375,114719),
