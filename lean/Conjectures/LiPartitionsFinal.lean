/-!
# Every integer partition of `31` is a connected partition type of `Li.T`

`Li.T` is the 31-vertex tree of `Conjectures/LiBasic.lean`.  Cutting a set of
its edges leaves a spanning forest; the sizes of its connected components form
an integer partition of `31`.  This file proves the converse: every one of the
`p(31) = 6842` integer partitions of `31` occurs as the component-size
multiset of some edge cut.

The witness data are the 6,842 rows generated by
`scripts/li_partitions_final_enum.py` from the verified edge-cut dynamic
program of `scripts/li_partitions_final.py` (canonical SHA-256
`30f51845828f4ec7b33a3762698b5a02148368d63a3503da3f496336f5f0fffd`); the rows
are in the order of the computable partition enumeration
`LiFinal.partsAux 31 31`.  Every row is checked in the kernel by `decide`
against the component-size checker `LiFinal.sizes` of
`Conjectures/LiPartitionsFinalCore.lean`.

The main results are:

* `certificate_ok`: all 6,842 rows pass the kernel checker;
* `certificate_parts`: the partition columns of the certificate are exactly
  `partsAux 31 31`;
* `all_partition_types`: every integer partition of `31` is realized by some
  cut mask;
* `T_hasAllPartitionTypes`: the tree `Li.T` has all connected partition types.
-/

namespace LiFinal

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! ## The certificate -/

/-- The certificate as one list: 6,842 `(partition, cut mask)` rows. -/
def certificate : List Row :=
  data00 ++ data01 ++ data02 ++ data03 ++ data04 ++ data05 ++ data06 ++
  data07 ++ data08 ++ data09 ++ data10 ++ data11 ++ data12 ++ data13

/-- Checking a concatenation splits into checking the two parts. -/
theorem chunkOk_append {a b : List Row} :
    chunkOk (a ++ b) = (chunkOk a && chunkOk b) := by
  simp [chunkOk, List.all_append]

/-- Every row of the certificate passes the kernel checker. -/
theorem certificate_ok : chunkOk certificate = true := by
  simp [certificate, data00_ok, data01_ok, data02_ok, data03_ok, data04_ok,
    data05_ok, data06_ok, data07_ok, data08_ok, data09_ok, data10_ok, data11_ok,
    data12_ok, data13_ok]

/-- The partitions whose largest part lies between `k + 1` and `k + d`, in the
order of `partsAuxF`. -/
def partsTail (fuel n k : Nat) : Nat → List (List Nat)
  | 0 => []
  | d + 1 => partsTail fuel n k d ++
      (if k + d < n + 1 then
        (partsAuxF (fuel + d) (n - (k + d)) (k + d + 1)).map (fun l => (k + d + 1) :: l)
      else [])

/-- Unfolding `partsAuxF` along the bound on the largest part. -/
theorem partsAuxF_eq_append_tail (fuel n k : Nat) :
    ∀ d, partsAuxF (fuel + d) (n + 1) (k + d) = partsAuxF fuel (n + 1) k ++ partsTail fuel n k d
  | 0 => by simp [partsTail]
  | d + 1 => by
      rw [show fuel + (d + 1) = (fuel + d) + 1 from rfl, show k + (d + 1) = (k + d) + 1 from rfl,
        partsAuxF, partsAuxF_eq_append_tail fuel n k d, partsTail, List.append_assoc]

/-- The partitions of `31` with largest part at most `8` come first. -/
theorem partsAux_31_split : partsAux 31 31 = partsAuxF 39 31 8 ++ partsTail 39 30 8 23 :=
  partsAuxF_eq_append_tail 39 30 8 23

/-- The first 2,857 certificate rows list the partitions with largest part at most `8`.
The comparison is split in two because one decision exceeds the CI memory cap. -/
theorem certificate_parts_take :
    (certificate.map (fun r => r.1)).take 2857 = partsAuxF 39 31 8 := by
  decide

/-- The remaining rows list the partitions with largest part from `9` to `31`. -/
theorem certificate_parts_drop :
    (certificate.map (fun r => r.1)).drop 2857 = partsTail 39 30 8 23 := by
  decide

/-- The partition columns of the certificate are exactly the computable
enumeration of the integer partitions of `31`. -/
theorem certificate_parts : certificate.map (fun r => r.1) = partsAux 31 31 := by
  rw [partsAux_31_split, ← certificate_parts_take, ← certificate_parts_drop, List.take_append_drop]

/-- The certificate has 6,842 rows. -/
theorem certificate_length : certificate.length = 6842 := by
  decide

/-- The computable enumeration has `p(31) = 6842` elements. -/
theorem partsAux_31_length : (partsAux 31 31).length = 6842 := by
  have h := congrArg List.length certificate_parts
  simpa [certificate_length] using h.symm

/-- Every partition in the enumeration is realized by a checked row. -/
theorem exists_mask_of_mem_partsAux {p : List Nat} (hp : p ∈ partsAux 31 31) :
    ∃ mask : Nat, sizes mask = p := by
  have hmem : p ∈ certificate.map (fun r => r.1) := by
    rw [certificate_parts]
    exact hp
  rcases List.mem_map.mp hmem with ⟨r, hr, hfirst⟩
  exact ⟨r.2, hfirst ▸ chunkOk_sound certificate_ok r hr⟩

/-! ## The coverage theorem -/

/-- A list of natural numbers is a connected partition type of `Li.T` if it is
the decreasing list of connected-component sizes of the spanning subgraph of
`Li.T` obtained by deleting some set of cut edges.  `cutGraph mask` is that
subgraph, and `componentCard` counts the vertices in a connected component. -/
def ConnectedPartitionType (p : List Nat) : Prop :=
  ∃ (mask : Nat) (C : List ((cutGraph mask).ConnectedComponent)),
    C.Nodup ∧
    (∀ D : (cutGraph mask).ConnectedComponent, D ∈ C) ∧
    p = sortDesc (C.map (componentCard (cutGraph mask)))

/-- Every integer partition of `31` is a connected partition type of `Li.T`,
in the genuine graph-theoretic sense. -/
theorem all_partition_types (p : List Nat) (hp : IsPartitionOf 31 p) :
    ConnectedPartitionType p := by
  rcases exists_mask_of_mem_partsAux (partsAux_complete_31 hp) with ⟨mask, hmask⟩
  rcases sizes_eq_components mask with ⟨C, hnodup, hcomplete, hsizes⟩
  exact ⟨mask, C, hnodup, hcomplete, by rw [← hsizes]; exact hmask.symm⟩

/-- Checker-level corollary: every integer partition is the `sizes` list of
some cut mask. -/
theorem all_partition_types_exists (p : List Nat) (hp : IsPartitionOf 31 p) :
    ∃ mask : Nat, sizes mask = p :=
  exists_mask_of_mem_partsAux (partsAux_complete_31 hp)

/-- Paper-form statement: the tree `Li.T` has all 6,842 connected partition
types. -/
theorem T_hasAllPartitionTypes :
    ∀ p : List Nat, IsPartitionOf 31 p → ConnectedPartitionType p :=
  all_partition_types

/-- Checker-level variant without fixing the order of the parts. -/
theorem all_partition_types_perm {p q : List Nat} (hp : IsPartitionOf 31 p)
    (hperm : q.Perm p) : ∃ mask : Nat, (sizes mask).Perm q := by
  rcases all_partition_types_exists p hp with ⟨mask, hmask⟩
  exact ⟨mask, by rw [hmask]; exact hperm.symm⟩

/-- The list of realized partition types is exactly the computable enumeration
of the integer partitions of `31`. -/
theorem realized_types_eq_partsAux :
    certificate.map (fun r => r.1) = partsAux 31 31 :=
  certificate_parts

end LiFinal
