def route (i : Fin 45) : List Vertex := storedPaths[i.val]'(by exact i.isLt)
def routeMask (i : Fin 45) : ℕ := storedMasks[i.val]'(by exact i.isLt)
def RouteSound (i : Fin 45) : Prop :=
  InducedPath witnessGraph (route i).get ∧ ∀ v : Vertex,(routeMask i).testBit v=true ↔ v∈route i

instance (i : Fin 45) : Decidable (RouteSound i) := by unfold RouteSound;infer_instance

