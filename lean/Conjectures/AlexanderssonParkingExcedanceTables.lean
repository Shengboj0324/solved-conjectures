import Mathlib.Data.Nat.Factorial.Basic

/-! The length-17 counting recurrence and its kernel certificates.

This module needs only natural-number factorials, so its import baseline stays well
below the main module's. That keeps the largest kernel check, `table1_certified`,
within the `-M4500` memory cap of `lake build` on Linux runners. The main module
proves that the recurrence counts parking words. -/

namespace AlexanderssonParkingExcedance

abbrev CountTable (n : ℕ) := Vector (Vector ℕ (n + 1)) (n + 1)

def fastChoose (n k : ℕ) : ℕ :=
  n.descFactorial k / k.factorial

def initialTable (n : ℕ) : CountTable n :=
  Vector.ofFn fun i => Vector.ofFn fun k => if i.val = 0 ∧ k.val = 0 then 1 else 0

def nextTable {n : ℕ} (j : ℕ) (previous : CountTable n) : CountTable n :=
  Vector.ofFn fun i => Vector.ofFn fun k =>
    if j + 1 ≤ i.val + k.val ∧ i.val + k.val ≤ n then
      (List.ofFn fun a : Fin (i.val + 1) =>
        (List.ofFn fun b : Fin (k.val + 1) =>
          previous[a.val][b.val] * fastChoose (j - b.val) (k.val - b.val) *
            fastChoose i.val (i.val - a.val)).sum).sum
    else 0

def table (n : ℕ) : ℕ → CountTable n
  | 0 => initialTable n
  | j + 1 => nextTable j (table n j)

def markedCounts (n : ℕ) : List ℕ :=
  let t := table n n
  List.ofFn fun k : Fin (n + 1) => t[n - k.val][k.val]


