import Conjectures.FiscusGridMasks

/-! The candidate bit for each legal position is checked against the complete
normal-play recurrence. Its generation is independent of the proof of that recurrence. -/

namespace FiscusGrid

def value (s : ℕ) : Bool := ( : ℕ).testBit s

def hasReply (s : ℕ) : Bool :=
  (List.finRange 14).any fun i => !s.testBit i.val && !value (s ||| 2^i.val)

def consistent (s : ℕ) : Bool := value s == (!covered s && hasReply s)

def checkedBlock (b : ℕ) : Bool :=
  (List.range 256).all fun offset => consistent (256*b+offset)

theorem consistent_spec {s : ℕ} (h : consistent s=true) :
    value s=true ↔ covered s=false ∧
      ∃ i : Fin 14, s.testBit i.val=false ∧ value (s ||| 2^i.val)=false := by
  have e : value s = (!covered s && hasReply s) := beq_iff_eq.mp h
  rw [e]
  simp [hasReply]

end FiscusGrid
